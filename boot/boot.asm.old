[BITS 16]
[ORG 0x7C00]

start:
    cli
    xor ax, ax
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov sp, 0x7C00
    sti

    ; Load 8 sectors (4 KB) of kernel to 0x1000:0000
    mov ax, 0x1000
    mov es, ax
    xor bx, bx
    mov ah, 0x02        ; BIOS Read Sectors
    mov al, 8           ; Sector count
    mov ch, 0           ; Cylinder 0
    mov cl, 2           ; Sector 2 (right after MBR)
    mov dh, 0           ; Head 0
    int 0x13
    jc  disk_err

    jmp 0x1000:0000

disk_err:
    hlt
    jmp disk_err

times 510 - ($ - $$) db 0
dw 0xAA55
