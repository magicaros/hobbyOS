10 REM ==========================================
20 REM hobbyOS BASIC Event Trapping Test Suite
30 REM ==========================================
40 CLS
50 PRINT "hobbyOS BASIC Event Trapping Test"
60 PRINT "================================="
70 PRINT

100 REM --- 1. KEY STATEMENT & SOFTKEYS ---
110 PRINT "--- 1. KEY STATEMENT & SOFTKEYS ---"
120 KEY ON
130 KEY OFF
140 KEY 1, "HELLO"
150 KEY 2, "WORLD"
160 PRINT "KEY ON/OFF & DEFINITIONS: PASSED"
170 PRINT

200 REM --- 2. KEY TRAP SYNTAX & VALIDATION ---
210 PRINT "--- 2. KEY TRAP SYNTAX & VALIDATION ---"
220 ON KEY(1) GOSUB 2000
230 KEY(1) ON
240 KEY(1) STOP
250 KEY(1) OFF
260 ON ERROR GOTO 1100
270 ERR_FLAG = 0
280 KEY(0) ON
290 REM Should not reach here
300 IF ERR_FLAG = 1 THEN PRINT "KEY VALIDATION:           PASSED" ELSE PRINT "KEY VALIDATION:           FAILED"
310 ON ERROR GOTO 0
320 PRINT

400 REM --- 3. RETURN WITH TARGET LINE ---
410 PRINT "--- 3. RETURN WITH TARGET LINE ---"
420 RET_FLAG = 0
430 GOSUB 3000
440 PRINT "RETURN TARGET:            FAILED (fallthrough)" : GOTO 500
450 RET_FLAG = 1
460 IF RET_FLAG = 1 THEN PRINT "RETURN TARGET:            PASSED" ELSE PRINT "RETURN TARGET:            FAILED"
470 PRINT

500 REM --- 4. TIMER EVENT TRAPPING (ON TIMER) ---
510 PRINT "--- 4. TIMER EVENT TRAPPING ---"
520 TC = 0
530 ON TIMER(1) GOSUB 1000
540 TIMER ON
550 PRINT "Waiting for 2 timer events..."
560 TSTART = TIMER
570 WHILE TC < 2 AND (TIMER - TSTART) < 5.0
580 WEND
590 PRINT "Timer ticks received: "; TC
600 IF TC >= 2 THEN PRINT "TIMER ON TRAPPING:        PASSED" ELSE PRINT "TIMER ON TRAPPING:        FAILED"
610 PRINT

650 REM --- 5. TIMER STOP & PENDING FIRED ---
660 PRINT "--- 5. TIMER STOP & PENDING FIRED ---"
670 TIMER STOP
680 TC_BEFORE = TC
690 TWAIT = TIMER
700 WHILE (TIMER - TWAIT) < 1.3
710 WEND
720 TC_DURING = TC
730 REM Pending event should fire immediately upon TIMER ON
740 TIMER ON
750 TWAIT = TIMER
760 WHILE (TIMER - TWAIT) < 0.2
770 WEND
780 TC_AFTER = TC
790 PRINT "Before STOP: "; TC_BEFORE; " During STOP: "; TC_DURING; " After ON: "; TC_AFTER
800 IF TC_DURING = TC_BEFORE AND TC_AFTER > TC_DURING THEN PRINT "TIMER STOP / PENDING:     PASSED" ELSE PRINT "TIMER STOP / PENDING:     FAILED"
810 PRINT

850 REM --- 6. TIMER OFF DEACTIVATION ---
860 PRINT "--- 6. TIMER OFF DEACTIVATION ---"
870 TIMER OFF
880 TC_OFF = TC
890 TWAIT = TIMER
900 WHILE (TIMER - TWAIT) < 1.3
910 WEND
920 PRINT "At OFF: "; TC_OFF; " After 1.3s: "; TC
930 IF TC = TC_OFF THEN PRINT "TIMER OFF:                PASSED" ELSE PRINT "TIMER OFF:                FAILED"
940 PRINT

950 REM --- SUMMARY ---
960 PRINT "================================="
970 PRINT "ALL EVENT TRAPPING TESTS PASSED!"
980 PRINT "================================="
990 SYSTEM

1000 REM --- Timer ISR Subroutine ---
1010 TC = TC + 1
1020 RETURN

1100 REM --- Error Handler for Test 2 ---
1110 IF ERR = 5 THEN ERR_FLAG = 1
1120 RESUME 300

2000 REM --- Dummy Key ISR ---
2010 RETURN

3000 REM --- Subroutine with RETURN <linenum> ---
3010 RETURN 450
