10 REM hobbyOS BASIC Phase 16 Test Suite: Analog Gameport & Joystick (STICK, STRIG)
20 CLS
30 PRINT "Testing Phase 16: Analog Joystick & Gameport..."

100 REM === TEST 1: STICK(0..3) READOUT ===
110 SX0 = STICK(0)
120 SY0 = STICK(1)
130 SX1 = STICK(2)
140 SY1 = STICK(3)
150 PRINT "STICK(0..3):"; SX0; SY0; SX1; SY1
160 IF SX0 < 0 OR SX0 > 255 THEN PRINT "TEST 1 FAIL: SX0="; SX0: STOP
170 IF SY0 < 0 OR SY0 > 255 THEN PRINT "TEST 1 FAIL: SY0="; SY0: STOP
180 IF SX1 < 0 OR SX1 > 255 THEN PRINT "TEST 1 FAIL: SX1="; SX1: STOP
190 IF SY1 < 0 OR SY1 > 255 THEN PRINT "TEST 1 FAIL: SY1="; SY1: STOP
195 PRINT "TEST 1 (STICK READOUT): PASS"

200 REM === TEST 2: STRIG FUNCTIONS (0..7) ===
210 FOR I = 0 TO 7
220   S = STRIG(I)
230   IF S <> 0 AND S <> -1 THEN PRINT "TEST 2 FAIL: STRIG("; I; ")="; S: STOP
240 NEXT I
250 PRINT "TEST 2 (STRIG FUNCTIONS): PASS"

300 REM === TEST 3: STRIG STATEMENTS ===
310 STRIG ON
320 STRIG(0) ON
330 STRIG(0) STOP
340 STRIG(0) OFF
350 STRIG OFF
360 PRINT "TEST 3 (STRIG STATEMENTS): PASS"

400 REM === TEST 4: ON STRIG GOSUB SYNTAX ===
410 ON STRIG(0) GOSUB 900
420 STRIG(0) OFF
430 PRINT "TEST 4 (ON STRIG GOSUB): PASS"

500 PRINT "=== ALL PHASE 16 TESTS PASSED ==="
510 SYSTEM
900 RETURN
