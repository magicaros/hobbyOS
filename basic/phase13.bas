10 REM Phase 13 Test Suite: GW-BASIC Softkeys and Video Modes
20 PRINT "=== Phase 13 Test Suite ==="
30 REM Test 1: Softkeys & Scroll Clipping
40 PRINT "TEST 1: SOFTKEYS & SCROLL CLIPPING"
50 KEY ON
60 FOR I = 1 TO 30
70   PRINT "Scroll line"; I
80 NEXT I
90 R = CSRLIN
100 IF R > 24 THEN PRINT "FAIL: CSRLIN exceeded row 24: "; R: GOTO 500
110 PRINT "PASS: CSRLIN clamped to row "; R
120 REM Test 2: Custom KEY strings
130 PRINT "TEST 2: KEY ASSIGNMENT"
140 KEY 1, "CUSTOM"
150 KEY OFF
160 KEY ON
170 PRINT "PASS: KEY assignments & toggle completed"
180 REM Test 3: Screen 1 & Screen 2 Graphics
190 PRINT "TEST 3: SCREEN 1 & 2 GRAPHICS"
200 SCREEN 1
210 COLOR 1, 0
220 PSET (100, 100), 2
230 P = POINT(100, 100)
240 IF P <> 2 THEN PRINT "FAIL: POINT(100,100) = "; P: SCREEN 0: GOTO 500
250 LINE (0, 0)-(50, 50), 3
260 CIRCLE (160, 100), 40, 1
265 T = TIMER: WHILE TIMER - T < 2: WEND
270 SCREEN 2
280 PSET (200, 100), 1
290 P = POINT(200, 100)
300 IF P <> 1 THEN PRINT "FAIL: SCREEN 2 POINT = "; P: SCREEN 0: GOTO 500
310 CIRCLE (320, 100), 50, 1
315 T = TIMER: WHILE TIMER - T < 2: WEND
320 SCREEN 0
330 PRINT "PASS: Screen 1 & 2 graphics operations passed"
340 REM Test 4: VGA Modes (Mode 12 / Mode 13)
350 PRINT "TEST 4: VGA MODE DETECTION"
360 ON ERROR GOTO 430
370 SCREEN 12
380 PRINT "Running in SCREEN 12 (VGA present)"
385 T = TIMER: WHILE TIMER - T < 2: WEND
390 SCREEN 0
400 GOTO 460
430 REM Error handler for non-VGA
440 PRINT "PASS: SCREEN 12 correctly raised error "; ERR; " on non-VGA hardware"
450 RESUME 460
460 ON ERROR GOTO 0
470 PRINT "=== ALL PHASE 13 TESTS PASSED ==="
480 SYSTEM
500 PRINT "=== PHASE 13 TEST FAILED ==="
510 SYSTEM
