10 REM ===================================================
20 REM hobbyOS BASIC Phase 12 Final Feature Test Suite
30 REM ===================================================
40 CLS
50 PRINT "hobbyOS BASIC Phase 12 Feature Test"
60 PRINT "==================================="
70 PRINT

100 REM --- 1. SYSTEM CLOCK (DATE$, TIME$) ---
110 PRINT "--- 1. DATE$ & TIME$ (READ/WRITE) ---"
120 D$ = DATE$
130 T$ = TIME$
140 IF LEN(D$) = 10 AND MID$(D$, 3, 1) = "-" AND MID$(D$, 6, 1) = "-" THEN PRINT "DATE$ FORMAT:             PASSED" ELSE PRINT "DATE$ FORMAT:             FAILED"
150 IF LEN(T$) = 8 AND MID$(T$, 3, 1) = ":" AND MID$(T$, 6, 1) = ":" THEN PRINT "TIME$ FORMAT:             PASSED" ELSE PRINT "TIME$ FORMAT:             FAILED"
160 DATE$ = "12-25-2026"
170 IF DATE$ = "12-25-2026" THEN PRINT "DATE$ WRITE:              PASSED" ELSE PRINT "DATE$ WRITE:              FAILED"
180 TIME$ = "23:59:50"
190 IF LEFT$(TIME$, 5) = "23:59" THEN PRINT "TIME$ WRITE:              PASSED" ELSE PRINT "TIME$ WRITE:              FAILED"
200 PRINT

210 REM --- 2. SCREEN METRICS (CSRLIN, POS, TAB, SPC) ---
220 PRINT "--- 2. CSRLIN, POS, TAB, SPC ---"
230 LOCATE 14, 15
240 R% = CSRLIN: C% = POS(0)
250 IF R% = 14 AND C% = 15 THEN PRINT "CSRLIN & POS(0):          PASSED" ELSE PRINT "CSRLIN & POS(0):          FAILED: R="; R%; " C="; C%
260 PRINT TAB(20); "X";
270 P1% = POS(0)
280 PRINT SPC(10); "Y";
290 P2% = POS(0)
300 PRINT
310 IF P1% = 21 AND P2% = 32 THEN PRINT "TAB & SPC COLUMN METRICS: PASSED" ELSE PRINT "TAB & SPC COLUMN METRICS: FAILED: P1="; P1%; " P2="; P2%
320 PRINT

330 REM --- 3. BSAVE & BLOAD ---
340 PRINT "--- 3. BSAVE & BLOAD ---"
350 DEF SEG
360 POKE 500, 123
370 POKE 501, 234
380 POKE 502, 77
390 BSAVE "TESTMEM.BIN", 500, 3
400 POKE 500, 0: POKE 501, 0: POKE 502, 0
410 BLOAD "TESTMEM.BIN"
420 IF PEEK(500) = 123 AND PEEK(501) = 234 AND PEEK(502) = 77 THEN PRINT "BLOAD DEFAULT OFFSET:     PASSED" ELSE PRINT "BLOAD DEFAULT OFFSET:     FAILED"
430 BLOAD "TESTMEM.BIN", 600
440 IF PEEK(600) = 123 AND PEEK(601) = 234 AND PEEK(602) = 77 THEN PRINT "BLOAD OVERRIDE OFFSET:    PASSED" ELSE PRINT "BLOAD OVERRIDE OFFSET:    FAILED"
450 PRINT

460 REM --- 4. FILE & DIRECTORY MANAGEMENT (NAME, KILL, MKDIR, CHDIR, RMDIR) ---
470 PRINT "--- 4. FILE & DIR MANAGEMENT ---"
480 NAME "TESTMEM.BIN" AS "RENAMED.BIN"
490 BLOAD "RENAMED.BIN", 700
500 IF PEEK(700) = 123 THEN PRINT "NAME AS (RENAME):         PASSED" ELSE PRINT "NAME AS (RENAME):         FAILED"
510 KILL "RENAMED.BIN"
520 PRINT "KILL (DELETE):            PASSED"
530 MKDIR "SUBDIR"
540 CHDIR "SUBDIR"
550 CHDIR "/"
560 RMDIR "SUBDIR"
570 PRINT "MKDIR/CHDIR/RMDIR:        PASSED"
580 PRINT

590 REM --- 5. GRAPHICS PIXEL READ (POINT) ---
600 PRINT "--- 5. GRAPHICS POINT(x, y) ---"
610 SCREEN 1
620 PSET (100, 50), 2
630 COL% = POINT(100, 50)
640 OUT_COL% = POINT(400, 50)
650 SCREEN 0
660 IF COL% = 2 AND OUT_COL% = -1 THEN PRINT "POINT(x, y):              PASSED" ELSE PRINT "POINT(x, y):              FAILED: COL="; COL%
670 PRINT

680 REM --- 6. TRACE ON / OFF (TRON/TROFF) ---
690 PRINT "--- 6. TRON / TROFF ---"
700 TRON
710 A = 1
720 B = 2
730 TROFF
740 PRINT "TRON / TROFF:             PASSED"
750 PRINT

760 PRINT "================================================="
770 PRINT "ALL PHASE 12 GW-BASIC FEATURES TESTED OK!"
780 PRINT "================================================="
790 SYSTEM
