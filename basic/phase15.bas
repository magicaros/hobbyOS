10 REM hobbyOS BASIC Phase 15 Test Suite: Low-Level Interop (VARPTR, CALL, WAIT)
20 CLS
30 PRINT "Testing Phase 15: Low-Level Interop..."

100 REM === TEST 1: VARPTR SCALAR ===
110 X% = 1234
120 P% = VARPTR(X%)
130 IF P% = 0 THEN PRINT "TEST 1 FAIL: P% = 0": STOP
140 DEF SEG
150 V = PEEK(P%) + PEEK(P% + 1) * 256
160 IF V <> 1234 THEN PRINT "TEST 1 FAIL: V="; V: STOP
170 POKE P%, 56: POKE P% + 1, 0
180 IF X% <> 56 THEN PRINT "TEST 1 FAIL: X%="; X%: STOP
190 PRINT "TEST 1 (VARPTR SCALAR): PASS"

200 REM === TEST 2: VARPTR ARRAY ===
210 DIM A%(5)
220 A%(0) = 1111: A%(1) = 2222
230 P0% = VARPTR(A%(0))
240 P1% = VARPTR(A%(1))
250 IF P1% - P0% <> 2 THEN PRINT "TEST 2 FAIL: P1%-P0%="; P1% - P0%: STOP
260 PRINT "TEST 2 (VARPTR ARRAY): PASS"

300 REM === TEST 3: VARPTR FILE BUFFER ===
310 OPEN "O", #1, "TEST15.TMP"
320 PF% = VARPTR(#1)
330 CLOSE #1
340 KILL "TEST15.TMP"
350 IF PF% = 0 THEN PRINT "TEST 3 FAIL: PF% = 0": STOP
360 PRINT "TEST 3 (VARPTR FILE): PASS"

400 REM === TEST 4: CALL 0 ARGS ===
410 CODE% = &HCB
420 DEF SEG
430 ADDR% = VARPTR(CODE%)
440 CALL ADDR%
450 CALL VARPTR(CODE%)
460 PRINT "TEST 4 (CALL 0 ARGS): PASS"

500 REM === TEST 5: CALL 1 ARG (MODIFY VIA POINTER) ===
510 CODE$ = "12345678901234567890"
520 DEF SEG
530 AD% = VARPTR(CODE$)
540 POKE AD%,   &H55 : POKE AD%+1, &H89 : POKE AD%+2, &HE5
550 POKE AD%+3, &H8B : POKE AD%+4, &H5E : POKE AD%+5, &H06
560 POKE AD%+6, &H83 : POKE AD%+7, &H07 : POKE AD%+8, &H64
570 POKE AD%+9, &H5D : POKE AD%+10,&HCB
580 V% = 50
590 CALL AD%(V%)
600 IF V% <> 150 THEN PRINT "TEST 5 FAIL: V%="; V%: STOP
610 PRINT "TEST 5 (CALL 1 ARG): PASS"

620 REM === TEST 6: CALL ARRAY ELEMENT ARG ===
630 DIM B%(3)
640 B%(1) = 200
650 CALL AD%(B%(1))
660 IF B%(1) <> 300 THEN PRINT "TEST 6 FAIL: B%(1)="; B%(1): STOP
670 PRINT "TEST 6 (CALL ARRAY ARG): PASS"

700 REM === TEST 7: WAIT STATEMENT ===
710 WAIT &H40, 1
720 WAIT &H40, 1, 1
730 PRINT "TEST 7 (WAIT): PASS"

800 PRINT "=== ALL PHASE 15 TESTS PASSED ==="
810 SYSTEM
