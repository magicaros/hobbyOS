10 REM ===================================================
20 REM hobbyOS BASIC Random File & Binary Field Test Suite
30 REM ===================================================
40 CLS
50 PRINT "hobbyOS BASIC Random-Access File Test"
60 PRINT "====================================="
70 PRINT

100 REM --- 1. BINARY CONVERSION FUNCTIONS ---
110 PRINT "--- 1. BINARY CONVERSION (MKI$/CVI, MKS$/CVS) ---"
120 I1% = 1234
130 I2% = -567
140 I3% = 0
150 S1$ = MKI$(I1%)
160 S2$ = MKI$(I2%)
170 S3$ = MKI$(I3%)
180 IF CVI(S1$) = 1234 AND CVI(S2$) = -567 AND CVI(S3$) = 0 THEN PRINT "MKI$/CVI:                 PASSED" ELSE PRINT "MKI$/CVI:                 FAILED"
190 F1! = 123.5
200 S4$ = MKS$(F1!)
210 F2! = CVS(S4$)
220 IF ABS(F2! - 123.5) < 0.01 THEN PRINT "MKS$/CVS:                 PASSED" ELSE PRINT "MKS$/CVS:                 FAILED"
230 PRINT

300 REM --- 2. RANDOM-ACCESS FILE CREATION & FIELD ---
310 PRINT "--- 2. OPEN 'R', FIELD, LSET/RSET, PUT ---"
320 OPEN "R", #1, "TEST.DAT", 32
330 IF LOC(1) = 0 THEN PRINT "INITIAL LOC(1) = 0:       PASSED" ELSE PRINT "INITIAL LOC(1) = 0:       FAILED"
340 FIELD #1, 4 AS ID$, 20 AS NAME$, 4 AS BAL$, 4 AS EXTRA$
350 LSET ID$ = MKI$(101)
360 LSET NAME$ = "Alice Smith"
370 LSET BAL$ = MKS$(150.5)
380 LSET EXTRA$ = "OK"
390 PUT #1, 1
400 IF LOC(1) = 1 THEN PRINT "PUT #1, 1 LOC(1):         PASSED" ELSE PRINT "PUT #1, 1 LOC(1):         FAILED"
410 IF LOF(1) >= 32 THEN PRINT "LOF(1) >= 32:             PASSED" ELSE PRINT "LOF(1) >= 32:             FAILED"
420 PRINT

500 REM --- 3. NON-SEQUENTIAL RANDOM WRITE (RECORD 5) ---
510 PRINT "--- 3. NON-SEQUENTIAL RANDOM WRITE ---"
520 LSET ID$ = MKI$(105)
530 LSET NAME$ = "Bob Jones"
540 LSET BAL$ = MKS$(999.0)
550 LSET EXTRA$ = "DONE"
560 PUT #1, 5
570 IF LOC(1) = 5 THEN PRINT "PUT #1, 5 LOC(1):         PASSED" ELSE PRINT "PUT #1, 5 LOC(1):         FAILED"
580 IF LOF(1) >= 160 THEN PRINT "LOF(1) >= 160:            PASSED" ELSE PRINT "LOF(1) >= 160:            FAILED"
590 PRINT

600 REM --- 4. RANDOM READ BACK (RECORD 1 & 5) ---
610 PRINT "--- 4. RANDOM READ BACK (GET) ---"
620 GET #1, 1
630 IF LOC(1) = 1 AND CVI(ID$) = 101 THEN PRINT "GET #1, 1 ID$:            PASSED" ELSE PRINT "GET #1, 1 ID$:            FAILED"
640 IF LEFT$(NAME$, 11) = "Alice Smith" THEN PRINT "GET #1, 1 NAME$:          PASSED" ELSE PRINT "GET #1, 1 NAME$:          FAILED"
650 IF ABS(CVS(BAL$) - 150.5) < 0.01 THEN PRINT "GET #1, 1 BAL$:           PASSED" ELSE PRINT "GET #1, 1 BAL$:           FAILED"
660 GET #1, 5
670 IF LOC(1) = 5 AND CVI(ID$) = 105 THEN PRINT "GET #1, 5 ID$:            PASSED" ELSE PRINT "GET #1, 5 ID$:            FAILED"
680 IF LEFT$(NAME$, 9) = "Bob Jones" THEN PRINT "GET #1, 5 NAME$:          PASSED" ELSE PRINT "GET #1, 5 NAME$:          FAILED"
690 IF ABS(CVS(BAL$) - 999.0) < 0.01 THEN PRINT "GET #1, 5 BAL$:           PASSED" ELSE PRINT "GET #1, 5 BAL$:           FAILED"
700 PRINT

710 REM --- 5. SEQUENTIAL DEFAULT PUT/GET ---
720 PRINT "--- 5. SEQUENTIAL DEFAULT PUT/GET ---"
730 LSET ID$ = MKI$(106)
740 LSET NAME$ = "Charlie Brown"
750 LSET BAL$ = MKS$(50.25)
760 PUT #1
770 IF LOC(1) = 6 THEN PRINT "DEFAULT PUT LOC(1) = 6:    PASSED" ELSE PRINT "DEFAULT PUT LOC(1) = 6:    FAILED"
780 GET #1, 6
790 IF CVI(ID$) = 106 AND LEFT$(NAME$, 13) = "Charlie Brown" THEN PRINT "DEFAULT GET REC 6:        PASSED" ELSE PRINT "DEFAULT GET REC 6:        FAILED"
800 CLOSE #1
810 PRINT "CLOSE #1:                 PASSED"
820 PRINT

850 REM --- 6. PERSISTENCE CHECK ACROSS OPEN/CLOSE ---
860 PRINT "--- 6. PERSISTENCE ACROSS REOPEN ---"
870 OPEN "TEST.DAT" AS #1 LEN = 32
880 FIELD #1, 4 AS ID$, 20 AS NAME$, 4 AS BAL$, 4 AS EXTRA$
890 GET #1, 5
900 IF CVI(ID$) = 105 AND LEFT$(NAME$, 9) = "Bob Jones" THEN PRINT "PERSISTENCE REC 5:        PASSED" ELSE PRINT "PERSISTENCE REC 5:        FAILED"
910 GET #1, 1
920 IF CVI(ID$) = 101 AND LEFT$(NAME$, 11) = "Alice Smith" THEN PRINT "PERSISTENCE REC 1:        PASSED" ELSE PRINT "PERSISTENCE REC 1:        FAILED"
930 CLOSE #1
940 PRINT

950 PRINT "================================================="
960 PRINT "ALL RANDOM-ACCESS FILE & BINARY TESTS PASSED OK!"
970 PRINT "================================================="
980 SYSTEM
