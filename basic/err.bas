10 REM ==========================================
20 REM hobbyOS BASIC Error Handling Test Suite
30 REM ==========================================
40 CLS
50 PRINT "hobbyOS BASIC Error Handling Test"
60 PRINT "================================="
70 PRINT

100 REM --- 1. ON ERROR GOTO & RESUME NEXT ---
110 PRINT "--- 1. ON ERROR GOTO & RESUME NEXT ---"
120 E1 = 0 : L1 = 0 : T1 = 0
130 ON ERROR GOTO 1000
140 T1 = 10 : X = 10 / 0 : T1 = 20
150 PRINT "ERR = "; E1; " (expected 11), ERL = "; L1; " (expected 140), T1 = "; T1; " (expected 20)"
160 IF E1 = 11 AND L1 = 140 AND T1 = 20 THEN PRINT "DIV/0 RESUME NEXT: PASSED" ELSE PRINT "DIV/0 RESUME NEXT: FAILED"
170 PRINT

200 REM --- 2. RESUME 0 RETRY ---
210 PRINT "--- 2. RESUME 0 RETRY ---"
220 E2 = 0 : L2 = 0 : D = 0 : RETRIED = 0
230 ON ERROR GOTO 1100
240 Q = 100 / D
250 PRINT "Q = "; Q; " (expected 20), RETRIED = "; RETRIED; " (expected 1)"
260 IF Q = 20 AND RETRIED = 1 AND E2 = 11 AND L2 = 240 THEN PRINT "RESUME 0 RETRY:   PASSED" ELSE PRINT "RESUME 0 RETRY:   FAILED"
270 PRINT

300 REM --- 3. ERROR STMT & RESUME LINE ---
310 PRINT "--- 3. ERROR STMT & RESUME LINE ---"
320 E3 = 0 : L3 = 0 : REACHED = 0
330 ON ERROR GOTO 1200
340 ERROR 55
350 PRINT "ERROR STMT: FAILED (executed line 350)" : GOTO 400
360 REACHED = 1
370 PRINT "ERR = "; E3; " (expected 55), ERL = "; L3; " (expected 340)"
380 IF E3 = 55 AND L3 = 340 AND REACHED = 1 THEN PRINT "ERROR & RESUME LN: PASSED" ELSE PRINT "ERROR & RESUME LN: FAILED"
390 PRINT

400 REM --- 4. COMPUTED ON...GOTO ---
410 PRINT "--- 4. COMPUTED ON...GOTO ---"
420 G1 = 0 : G2 = 0 : G3 = 0
430 I = 1 : ON I GOTO 460, 470, 480
440 PRINT "ON GOTO: FAILED (fallthrough 1)" : GOTO 500
460 G1 = 1 : GOTO 490
470 G2 = 1 : GOTO 490
480 G3 = 1 : GOTO 490
490 I = 2 : ON I GOTO 460, 492, 480
491 PRINT "ON GOTO: FAILED (fallthrough 2)" : GOTO 500
492 G2 = 1 : I = 3 : ON I GOTO 460, 470, 495
493 PRINT "ON GOTO: FAILED (fallthrough 3)" : GOTO 500
495 G3 = 1
496 PRINT "G1 = "; G1; " G2 = "; G2; " G3 = "; G3
497 IF G1 = 1 AND G2 = 1 AND G3 = 1 THEN PRINT "COMPUTED ON GOTO: PASSED" ELSE PRINT "COMPUTED ON GOTO: FAILED"
498 PRINT

500 REM --- 5. COMPUTED ON...GOSUB ---
510 PRINT "--- 5. COMPUTED ON...GOSUB ---"
520 S1 = 0 : S2 = 0
530 K = 1 : ON K GOSUB 1300, 1310
540 K = 2 : ON K GOSUB 1300, 1310
550 PRINT "S1 = "; S1; " S2 = "; S2
560 IF S1 = 1 AND S2 = 1 THEN PRINT "COMPUTED ON GOSUB:PASSED" ELSE PRINT "COMPUTED ON GOSUB:FAILED"
570 PRINT

600 REM --- 6. MULTI-STATEMENT RESUME NEXT ---
610 PRINT "--- 6. MULTI-STATEMENT RESUME NEXT ---"
620 E6 = 0 : L6 = 0 : M1 = 0 : M2 = 0
630 ON ERROR GOTO 1400
640 M1 = 1 : ERROR 5 : M2 = 2
650 PRINT "M1 = "; M1; " M2 = "; M2; " ERR = "; E6; " ERL = "; L6
660 IF M1 = 1 AND M2 = 2 AND E6 = 5 AND L6 = 640 THEN PRINT "MULTI-STMT RESUME:PASSED" ELSE PRINT "MULTI-STMT RESUME:FAILED"
670 PRINT

700 REM --- SUMMARY ---
710 ON ERROR GOTO 0
720 PRINT "================================="
730 PRINT "ALL ERROR HANDLING TESTS PASSED!"
740 PRINT "================================="
750 END

1000 REM --- Handler 1 ---
1010 E1 = ERR : L1 = ERL
1020 RESUME NEXT

1100 REM --- Handler 2 ---
1110 E2 = ERR : L2 = ERL : RETRIED = 1 : D = 5
1120 RESUME 0

1200 REM --- Handler 3 ---
1210 E3 = ERR : L3 = ERL
1220 RESUME 360

1300 S1 = 1 : RETURN
1310 S2 = 1 : RETURN

1400 REM --- Handler 6 ---
1410 E6 = ERR : L6 = ERL
1420 RESUME NEXT
